<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
  <section id="service.kofin.companion">
    <category id="general" label="30000" help="30001">
      <group id="1" label="30002">
        <!-- One toggle per request family. Off refuses the family's
             requests with a reason Kofin reports; it withdraws nothing
             already written, because the rows are Kodi's and a withdrawal
             is Kofin's to ask for. -->
        <setting id="groupVersions" type="boolean" label="30010" help="30011">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="chapterArt" type="boolean" label="30012" help="30013">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="assetLifecycle" type="boolean" label="30014" help="30015">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="videoMetadata" type="boolean" label="30016" help="30017">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
      </group>
      <group id="2" label="30003">
        <setting id="reconcileNow" type="action" label="30020" help="30021">
          <level>0</level>
          <data>RunScript(service.kofin.companion,reconcile)</data>
          <control type="button" format="action"/>
        </setting>
        <setting id="showStatus" type="action" label="30022" help="30023">
          <level>0</level>
          <data>RunScript(service.kofin.companion,status)</data>
          <control type="button" format="action"/>
        </setting>
      </group>
    </category>
  </section>
</settings>
